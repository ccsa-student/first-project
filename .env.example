# Copy to .env and fill in. .env is gitignored.

# Required only for the LLM layer (Proposer / Value generator / Planner).
# The Jev decision core runs without it.
OPENROUTER_API_KEY=

# Optional. Jev currently requires no authentication; if that changes,
# set this and the client will start sending an Authorization header.
TYPESAFE_API_KEY=
